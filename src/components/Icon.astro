---
/**
 * Inline SVG icons for the services grid — no icon font, no sprite request.
 * Parallax-One used Font Awesome, which cost a ~75 KB webfont to draw seven
 * glyphs; these are a few hundred bytes of markup and inherit currentColor.
 */
interface Props {
  name: 'shield' | 'server' | 'cloud' | 'lock' | 'phone' | 'camera' | 'cable'
  size?: number
}
const { name, size = 26 } = Astro.props

const paths: Record<string, string> = {
  shield: 'M12 3l7 3v6c0 4.2-2.9 7.7-7 9-4.1-1.3-7-4.8-7-9V6l7-3Z',
  server:
    'M4 5h16v5H4zM4 14h16v5H4zM7.5 7.5h.01M7.5 16.5h.01',
  cloud: 'M7 18a4 4 0 0 1-.4-8A5.5 5.5 0 0 1 17 9.5a3.5 3.5 0 0 1 .5 8.5H7Z',
  lock: 'M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3',
  phone:
    'M6 3h3l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z',
  camera: 'M3 7h11v10H3zM14 10l7-3v10l-7-3',
  cable: 'M4 20V9a3 3 0 0 1 6 0v6a3 3 0 0 0 6 0V4M2 20h4M18 4h4',
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]} />
</svg>
