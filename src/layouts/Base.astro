---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import mark from '../assets/mark.png'

interface Props {
  title: string
  /** Primary line in the header — the subject of this page. Renders as the h1. */
  heading: string
  /** Secondary line beneath it. */
  subheading?: string
  description?: string
  jsonLd?: Record<string, unknown> | null
  /** Error pages: no canonical, kept out of the index. */
  noindex?: boolean
  /** Home page: full-bleed hero instead of the standard header. */
  hero?: boolean
}

const {
  title,
  heading,
  subheading,
  description = 'Managed IT, cloud, security, VOIP and cabling for businesses. Simple, reliable and awesome.',
  jsonLd = null,
  noindex = false,
  hero = false,
} = Astro.props

if (!heading) throw new Error(`Base.astro: ${Astro.url.pathname} is missing heading`)

const SITE_NAME = 'Innovative Technology Solutions'

// Normalise to a single canonical form: directory paths always end in a slash,
// so /foo and /foo/ never advertise themselves as two pages to a search engine.
const path = Astro.url.pathname
const isFile = /\.[a-z0-9]+$/i.test(path.split('/').pop() ?? '')
const canonical = new URL(isFile || path.endsWith('/') ? path : `${path}/`, Astro.site).href
const ogImage = new URL('/icon-512.png', Astro.site).href

const services = (await getCollection('services', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
)
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#212f6e" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0b1020" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <style is:global>
      /* Palette taken from the ITC logo: navy #212f6e, red #ed1b24. System font
         stack rather than the theme's Cabin + Open Sans — two Google Font
         families cost ~90 KB and a third-party connection to render text that
         renders fine natively. */
      :root {
        --navy: #212f6e;
        --red: #ed1b24;
        --fg: #16192b;
        --muted: #5b6379;
        --accent: #212f6e;
        --accent-ink: #ffffff;
        --bg: #f4f6fa;
        --surface: #ffffff;
        --rule: #dde2ec;
        --measure: 62rem;
        --gutter: clamp(1rem, 4vw, 1.75rem);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #e7ebf5;
          --muted: #98a1bb;
          --accent: #8ea3e8;
          --accent-ink: #0b1020;
          --bg: #0b1020;
          --surface: #141a30;
          --rule: #232b47;
        }
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
        color: var(--fg);
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        font-size: clamp(1rem, 0.97rem + 0.16vw, 1.0625rem);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        overflow-wrap: break-word;
      }
      main { flex: 1 0 auto; }

      .wrap {
        width: 100%;
        max-width: var(--measure);
        margin-inline: auto;
        padding-inline: var(--gutter);
      }

      a { color: var(--accent); text-underline-offset: 2px; }

      /* ---- nav ---- */
      nav.site {
        border-bottom: 1px solid var(--rule);
        background: var(--surface);
        position: sticky; top: 0; z-index: 10;
      }
      /* nowrap: the mobile panel is absolutely positioned rather than wrapped
         onto a second flex line. As a wrapped line it made .inner multi-line,
         and align-content:stretch then shifted the brand row every time the
         menu opened. */
      nav.site .inner {
        display: flex; align-items: center; gap: 1rem;
        height: 4rem; flex-wrap: nowrap;
      }
      nav.site .brand {
        display: flex; align-items: center; gap: .6rem;
        font-weight: 700; letter-spacing: -0.01em; color: var(--fg);
        text-decoration: none; margin-right: auto; line-height: 1.15;
      }
      nav.site .brand img { flex: none; display: block; }
      nav.site .brand .full { font-size: .95rem; }
      nav.site .brand .short { display: none; }
      @media (max-width: 46rem) {
        nav.site .brand .full { display: none; }
        nav.site .brand .short { display: inline; font-size: 1rem; }
      }
      nav.site .links { display: flex; gap: 1.15rem; align-items: center; }
      nav.site .links a { color: var(--muted); text-decoration: none; font-size: .875rem; white-space: nowrap; }
      nav.site .links a:hover, nav.site .links a[aria-current='page'] { color: var(--fg); }
      nav.site .links a[aria-current='page'] { font-weight: 600; }
      nav.site .links a.cta {
        background: var(--accent); color: var(--accent-ink);
        padding: .45rem .9rem; border-radius: 6px; font-weight: 600;
      }
      nav.site .links a.cta:hover { opacity: .9; color: var(--accent-ink); }

      /* Hamburger. Hidden on desktop; the button is always in the DOM so the
         markup works without JS — the panel simply stays open in that case. */
      nav.site .toggle {
        display: none; align-items: center; justify-content: center;
        width: 2.5rem; height: 2.5rem; padding: 0;
        background: transparent; border: 1px solid var(--rule); border-radius: 7px;
        color: var(--fg); cursor: pointer;
      }
      nav.site .toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      nav.site .toggle span {
        display: block; width: 1.1rem; height: 2px; background: currentColor;
        position: relative; transition: background .15s;
      }
      nav.site .toggle span::before,
      nav.site .toggle span::after {
        content: ''; position: absolute; left: 0; width: 1.1rem; height: 2px;
        background: currentColor; transition: transform .18s ease;
      }
      nav.site .toggle span::before { top: -6px; }
      nav.site .toggle span::after { top: 6px; }
      nav.site .toggle[aria-expanded='true'] span { background: transparent; }
      nav.site .toggle[aria-expanded='true'] span::before { transform: translateY(6px) rotate(45deg); }
      nav.site .toggle[aria-expanded='true'] span::after { transform: translateY(-6px) rotate(-45deg); }

      @media (max-width: 61rem) {
        nav.site .toggle { display: flex; }
        /* Absolute, so the bar keeps its exact 4rem height whether the panel is
           open or shut — nothing above it can move. */
        nav.site .links {
          display: none;
          position: absolute; top: 100%; left: 0; right: 0;
          flex-direction: column; align-items: stretch; gap: 0;
          background: var(--surface);
          border-bottom: 1px solid var(--rule);
          box-shadow: 0 10px 24px rgb(0 0 0 / 10%);
          padding: .25rem var(--gutter) 1rem;
          max-height: calc(100svh - 4rem);
          overflow-y: auto;
        }
        nav.site .links[data-open] { display: flex; }
        nav.site .links a {
          padding: .8rem 0; font-size: 1rem;
          border-bottom: 1px solid var(--rule);
        }
        nav.site .links a:last-of-type { border-bottom: 0; }
        nav.site .links a.cta {
          border-bottom: 0; margin-top: .85rem; text-align: center;
          padding: .75rem 1rem;
        }
      }

      /* ---- hero ----
         Theme stock photo behind a heavy navy wash: it reads as texture rather
         than as a photograph of a 2014 tablet. background-attachment gives the
         parallax feel on desktop; disabled on touch, where it is janky and
         iOS ignores it anyway. */
      .hero {
        position: relative;
        background-color: var(--navy);
        background-size: cover;
        background-position: center;
        color: #f2f5fc;
        padding-block: clamp(3.5rem, 11vw, 7.5rem);
        text-align: center;
        isolation: isolate;
      }
      @media (min-width: 48rem) and (hover: hover) {
        .hero { background-attachment: fixed; }
      }
      .hero::before {
        content: '';
        position: absolute; inset: 0; z-index: -1;
        background: linear-gradient(180deg, rgba(33,47,110,.88), rgba(11,16,32,.94));
      }
      .hero h1 {
        font-size: clamp(1.9rem, 1.3rem + 3vw, 3.1rem);
        line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 .75rem; font-weight: 700;
      }
      .hero p.tag {
        font-size: clamp(1.05rem, 1rem + .5vw, 1.3rem);
        color: #bcc8e8; margin: 0 auto 2rem; max-width: 36rem;
      }
      .btn {
        display: inline-block; background: var(--accent); color: var(--accent-ink);
        padding: .7rem 1.5rem; border-radius: 7px; font-weight: 600; text-decoration: none;
      }
      .btn:hover { opacity: .92; color: var(--accent-ink); }
      /* The page-level ghost: accent on the page background, in both themes.
         This used to be hardcoded near-white with a white ring, which was only
         ever correct because every use of it sat inside the navy hero. The
         first use on an ordinary surface rendered as invisible text. */
      .btn.ghost {
        background: transparent; color: var(--accent);
        box-shadow: inset 0 0 0 1px var(--rule); margin-left: .5rem;
      }
      .btn.ghost:hover { color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }

      /* The hero is navy, so a navy button would vanish into it. White reads
         cleanly against the wash and keeps the accent off the red. */
      .hero .btn { background: #fff; color: var(--navy); }
      .hero .btn:hover { color: var(--navy); }
      .hero .btn.ghost {
        background: transparent; color: #f2f5fc;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.4);
      }
      .hero .btn.ghost:hover { color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,.7); }

      /* ---- standard page header ---- */
      header.page { padding-block: clamp(2.25rem, 7vw, 3.5rem) clamp(1.25rem, 4vw, 2rem); }
      header.page h1 {
        font-size: clamp(1.55rem, 1.25rem + 1.4vw, 2.1rem);
        line-height: 1.2; letter-spacing: -0.015em; margin: 0 0 .35rem; font-weight: 700;
      }

      .meta {
        color: var(--muted); font-size: .75rem;
        letter-spacing: .06em; text-transform: uppercase; margin: 0;
      }

      /* ---- services grid ---- */
      section.block { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
      section.block > h2 {
        font-size: clamp(1.3rem, 1.1rem + .9vw, 1.7rem);
        margin: 0 0 .5rem; letter-spacing: -0.015em;
      }
      section.block > p.lead { color: var(--muted); margin: 0 0 2rem; max-width: 38rem; }

      .cards {
        list-style: none; margin: 0; padding: 0;
        display: grid; gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
      }
      .cards li {
        background: var(--surface); border: 1px solid var(--rule);
        border-radius: 10px; padding: 1.35rem;
      }
      .cards a.card-link { text-decoration: none; color: inherit; display: block; }
      .cards a.card-link:hover h3 { text-decoration: underline; }
      .cards .ico { color: var(--red); margin-bottom: .6rem; display: block; }
      .cards h3 { font-size: 1.0625rem; margin: 0 0 .3rem; font-weight: 650; }
      .cards p { margin: 0; color: var(--muted); font-size: .9375rem; line-height: 1.55; }

      article p { margin: 0 0 1.3em; max-width: 42rem; }
      article { padding-bottom: clamp(2rem, 6vw, 3rem); }

      /* ---- footer ---- */
      footer.site {
        margin-top: auto; border-top: 1px solid var(--rule);
        background: var(--surface);
        padding-block: clamp(2rem, 5vw, 2.75rem);
      }
      footer.site .cols {
        display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: space-between;
        margin-bottom: 1.25rem;
      }
      footer.site a { color: var(--muted); text-decoration: none; font-size: .875rem; }
      footer.site a:hover { color: var(--fg); }
      footer.site .fnav { display: flex; gap: 1rem; flex-wrap: wrap; }
      footer.site .credit { display: block; margin-top: .4rem; }
      @media (min-width: 34rem) {
        footer.site .credit { display: inline; margin-top: 0; }
        footer.site .credit::before { content: ' · '; }
      }

      pre { overflow-x: auto; }
      table { display: block; overflow-x: auto; max-width: 100%; }
    </style>
  </head>
  <body>
    <nav class="site">
      <div class="inner wrap">
        <a class="brand" href="/">
          <Image src={mark} alt="" width={34} height={34} densities={[1, 2]} format="webp" />
          <span class="full">Innovative Technology Solutions</span>
          <span class="short">InTech Solutions</span>
        </a>
        <button
          class="toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-links"
          aria-label="Menu"
        >
          <span></span>
        </button>

        <div class="links" id="nav-links">
          {services.map((s) => (
            <a href={s.data.originalUrl} aria-current={path === s.data.originalUrl ? 'page' : undefined}>
              {s.data.title}
            </a>
          ))}
          <a class="cta" href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>
            Contact
          </a>
        </div>
      </div>
    </nav>

    <script is:inline>
      // Progressive enhancement: without JS the panel is simply always visible
      // at narrow widths, so the nav still works.
      {
        const toggle = document.querySelector('nav.site .toggle')
        const links = document.getElementById('nav-links')
        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open))
          links.toggleAttribute('data-open', open)
        }
        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        )
        // Close on Escape, and when a link is followed.
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false)
            toggle.focus()
          }
        })
        links.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false)
        })
      }
    </script>

    {hero ? (
      <slot name="hero" />
    ) : (
      <header class="page wrap">
        <h1>{heading}</h1>
        {subheading && <p class="meta">{subheading}</p>}
      </header>
    )}

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="cols">
          <div class="fnav">
            {services.map((s) => <a href={s.data.originalUrl}>{s.data.title}</a>)}
          </div>
          <a href="/contact/">Contact</a>
        </div>
        <p class="meta">
          &copy; {year} Innovative Technology Solutions &middot; intechsolutions.net
          <span class="credit">Powered by <a href="https://mwhayden.net/">mwhayden.net</a></span>
        </p>
      </div>
    </footer>

    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => navigator.serviceWorker.register('/sw.js'))
        }
      </script>
    )}
  </body>
</html>
