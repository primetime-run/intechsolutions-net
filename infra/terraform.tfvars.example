# Copy to terraform.tfvars and edit. That file is gitignored.
#
# Required. The address contact form submissions are delivered to. Kept out of
# git because this repository is public.
contact_to = "someone@example.com"

# Cloudflare Turnstile secret key. Prefer the environment variable
# TF_VAR_turnstile_secret so it never touches disk.
# turnstile_secret = "..."
